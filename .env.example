# Copia a .env — mismo formato que Evidentia

# Supabase (frontend)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo backend / Edge Functions / scripts — nunca en el bundle del navegador
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (se configuran también en Supabase Dashboard → Auth → Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NVIDIA embeddings (Edge Function generate-embedding + scripts locales)
NVIDIA_API_KEY=
# Modelo: nv-embedqa-e5-v5
